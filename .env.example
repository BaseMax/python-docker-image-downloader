# Port the Flask app listens on
PORT=5000

# Set to "true" for verbose Flask output during development
DEBUG=false

# Optional: Docker Hub credentials.
# Without these, Docker Hub allows ~100 anonymous pulls per 6 hours (per server IP).
# With a free account, the limit rises to 200 pulls per 6 hours.
DOCKER_HUB_USERNAME=
DOCKER_HUB_PASSWORD=
